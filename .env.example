# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finsight
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finsight_test

# Auth
SECRET_KEY=                        # generate: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OAuth2 - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gemini (optional): enables the AI clean up feature for import fallback
GEMINI_API_KEY=

REDIRECT_URI=http://localhost:8000/auth/{provider}/callback

# App
WHITELIST=["example@email.com"]

# Accounts that see the dev tools panel. Subset of WHITELIST - an email here
# that can't register is meaningless. Empty means nobody.
ADMIN_EMAILS=["example@email.com"]
FRONTEND_URL=http://localhost:5173
DEV_URL=http://localhost:5173